    <worksheet name='Covid Overview'>
      <table>
        <view>
          <datasources>
            <datasource caption='owid-covid-data' name='federated.1tvmtbk1cb7vlu1byzt741w8wg9f' />
          </datasources>
          <datasource-dependencies datasource='federated.1tvmtbk1cb7vlu1byzt741w8wg9f'>
            <column caption='Case Fatality Rate' datatype='real' default-format='p0.00%' name='[Calculation_1348028923031554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_deaths])&#13;&#10;/&#13;&#10;SUM([total_cases])&#13;&#10;*100)/100' />
            </column>
            <column caption='Daily Growth Rate' datatype='real' name='[Calculation_2242481715093504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([new_cases]) / SUM([total_cases])) * 100' />
            </column>
            <column caption='Continent' datatype='string' name='[continent]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Location' datatype='string' name='[location]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column caption='New Cases' datatype='real' name='[new_cases]' role='measure' type='quantitative' />
            <column-instance column='[continent]' derivation='None' name='[none:continent:nk]' pivot='key' type='nominal' />
            <column-instance column='[date]' derivation='None' name='[none:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[location]' derivation='None' name='[none:location:nk]' pivot='key' type='nominal' />
            <column-instance column='[total_cases]' derivation='Sum' name='[sum:total_cases:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_deaths]' derivation='Sum' name='[sum:total_deaths:qk]' pivot='key' type='quantitative' />
            <column caption='Total Cases' datatype='real' name='[total_cases]' role='measure' type='quantitative' />
            <column caption='Total Deaths' datatype='real' name='[total_deaths]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1348028923031554]' derivation='User' name='[usr:Calculation_1348028923031554:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2242481715093504]' derivation='User' name='[usr:Calculation_2242481715093504:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.1tvmtbk1cb7vlu1byzt741w8wg9f].[none:date:qk]</column>
            <column>[federated.1tvmtbk1cb7vlu1byzt741w8wg9f].[none:continent:nk]</column>
